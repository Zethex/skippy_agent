# Home PC: copy to .env. Everything else (AI providers, which vault, your name) is set up
# in the app under Settings, so this file only holds what Docker needs before Skippy starts.

# A folder on this PC that contains your Obsidian vault(s), e.g. your Documents folder.
# Skippy can only see inside this folder; you choose (or create) the vault in Settings.
SKIPPY_VAULTS_DIR=C:/Users/you/Documents

TZ=Australia/Brisbane

# Optional
# SKIPPY_PORT=8642
# INSTALL_WHISPER=true            # false skips voice input
