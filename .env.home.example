# Home PC: copy to .env and fill in.

# Folder of your Obsidian vault on this machine (WSL path or Windows path both work with Docker Desktop).
OBSIDIAN_VAULT=/home/you/Obsidian/MyVault

# Claude subscription. Run `claude setup-token` once on this PC and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=

SKIPPY_USER_NAME=Dane
SKIPPY_PROVIDER=claude-code
TZ=Australia/Brisbane

# Optional
# SKIPPY_PORT=8642
# SKIPPY_VAULT_FOLDER=Skippy      # Skippy's own folder inside the vault
# SKIPPY_VAULT_WRITE=true         # false = Skippy can read the vault but never change it
# WHISPER_MODEL=base.en           # small.en is more accurate and slower
# CLAUDE_MODELS=sonnet,opus,haiku
