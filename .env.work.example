# Work PC: copy to .env and fill in. Everything goes through Portkey; the Claude CLI is not installed.

OBSIDIAN_VAULT=C:/Users/you/Documents/WorkVault

INSTALL_CLAUDE_CODE=false

PORTKEY_BASE_URL=https://your-portkey-host/v1
PORTKEY_API_KEY=
# Whichever of these your Portkey setup uses to pick the upstream provider:
# PORTKEY_VIRTUAL_KEY=
# PORTKEY_CONFIG=
# PORTKEY_PROVIDER=
# Model names exactly as your gateway expects them, comma-separated. The first is the default.
PORTKEY_MODELS=

SKIPPY_USER_NAME=Dane
SKIPPY_PROVIDER=portkey
TZ=Australia/Brisbane

# Corporate network extras
# HTTPS_PROXY=http://proxy.corp.example:8080
# SKIPPY_CA_BUNDLE=/app/config/corp-ca.pem    # drop the PEM into ./config
# PORTKEY_VERIFY_TLS=true
# PORTKEY_TOOLS=true              # false if your models reject function calling
# INSTALL_WHISPER=true            # false skips voice (the model downloads from huggingface.co on first use)
