# Work PC: copy to .env. Portkey and the vault are set up in the app under Settings;
# this file only holds what Docker needs before Skippy starts.

# A folder on this PC that contains your Obsidian vault(s). You choose the vault in Settings.
SKIPPY_VAULTS_DIR=C:/Users/you/Documents

# Everything goes through Portkey, so the Claude CLI isn't needed in the image.
INSTALL_CLAUDE_CODE=false

TZ=Australia/Brisbane

# Corporate network extras
# HTTPS_PROXY=http://proxy.corp.example:8080
# SKIPPY_CA_BUNDLE=/app/config/corp-ca.pem    # drop the PEM into ./config
# INSTALL_WHISPER=true            # false skips voice (the model downloads from huggingface.co on first use)
